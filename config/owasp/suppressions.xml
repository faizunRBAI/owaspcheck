<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      OWASP Dependency Check suppressions.

      This file is intentionally EMPTY of blanket suppressions. Any entry added
      here must state the CVE, the reason the finding does not apply to this
      application, and a review date. Suppressing a finding to make the build
      pass is a policy violation - upgrade the dependency instead.

      Example of an acceptable, justified entry:

      <suppress until="2026-12-31Z">
          <notes>CVE-XXXX-YYYY affects the server-side parser only; this
                 application uses the client codec exclusively.</notes>
          <packageUrl regex="true">^pkg:maven/com\.example/library@.*$</packageUrl>
          <cve>CVE-XXXX-YYYY</cve>
      </suppress>
    -->
</suppressions>
