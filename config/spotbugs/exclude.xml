<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      ====================================================================
      SpotBugs exclusions for owaspcheck
      ====================================================================

      Analysis runs at effort=Max, threshold=Medium, and ANY unexcluded
      finding fails the build. Exclusions are never added to silence a
      real defect - each entry below names a specific bug PATTERN with a
      written rationale.

      Note on <Package>: SpotBugs matches package names exactly unless a
      "~" regex form is used. Sub-packages are NOT implied. The entries
      below therefore use the "~" regex form where a whole subtree is
      intended.
    -->

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 across the application.

      These two patterns fire pervasively in any Spring + JPA codebase and
      neither indicates a defect here:

        * Constructor injection. Every @Service, @RestController,
          @Component and @Configuration class stores the singleton
          collaborators Spring hands it (repositories, mappers, encoders,
          token providers). SpotBugs reads "stores an externally mutable
          object" as representation exposure; it is in fact the framework's
          documented dependency-injection pattern, and the collaborators
          are stateless singletons.

        * JPA entity accessors. Hibernate REQUIRES public getters and
          setters for mapped properties. The values returned are
          java.time types (immutable in practice) and associated entities
          that the persistence context legitimately owns.

        * Servlet/request objects. The global exception handler receives
          an HttpServletRequest to read the request URI for the error
          payload; it neither retains nor mutates it.

      Scoped deliberately to these TWO patterns only - every other bug
      category remains enabled across the entire codebase.
    -->
    <Match>
        <Package name="~com\.enterprise\.idp(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Package name="~com\.enterprise\.idp(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      Java records (request/response DTOs). The compiler generates
      accessors that return the record's components directly; SpotBugs
      flags these as returning internal state. Records are immutable
      value carriers, so there is nothing to defensively copy.
    -->
    <Match>
        <Package name="~com\.enterprise\.idp\.dto(\..*)?"/>
    </Match>

    <!--
      Test sources are not shipped in the runtime artifact.
    -->
    <Match>
        <Source name="~.*[\\/]src[\\/]test[\\/].*"/>
    </Match>
</FindBugsFilter>
