<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      ====================================================================
      SpotBugs exclusions for owaspcheck
      ====================================================================

      Analysis runs at effort=Max, threshold=Medium, and ANY unexcluded
      finding fails the build.

      This file is deliberately MINIMAL. An earlier revision carried a
      broad EI_EXPOSE_REP / EI_EXPOSE_REP2 exclusion across the whole
      com.enterprise.idp tree, added on the assumption that Spring
      constructor injection and JPA accessors were flooding the report.
      The published spotbugs-report artifact disproved that: the analysis
      reported exactly ONE bug, and it was CT_CONSTRUCTOR_THROW in
      JwtTokenProvider. That exclusion was suppressing nothing real, so
      it has been removed rather than left in place as dead policy.

      CT_CONSTRUCTOR_THROW itself is NOT excluded either - it was fixed at
      the source by declaring JwtTokenProvider final, which removes the
      finalizer-attack vector while keeping the fail-fast key-length
      validation.

      Note on <Package>: SpotBugs matches package names exactly unless the
      "~" regex form is used. Sub-packages are NOT implied.

      Before adding anything here: download the spotbugs-report artifact
      from the failing run and read the actual finding. Do not infer.
    -->

    <!--
      Java records (request/response DTOs). The compiler generates
      accessors that return the record's components directly; SpotBugs
      flags these as returning internal state. Records are immutable
      value carriers, so there is nothing to defensively copy.
    -->
    <Match>
        <Package name="~com\.enterprise\.idp\.dto(\..*)?"/>
    </Match>

    <!--
      Test sources are not shipped in the runtime artifact.
    -->
    <Match>
        <Source name="~.*[\\/]src[\\/]test[\\/].*"/>
    </Match>
</FindBugsFilter>
