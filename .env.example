# Local development configuration for the Internal Developer Portal.
# Copy to .env and adjust. NEVER commit a filled-in .env file.
# In CI and on the deployed host these values come from repository secrets.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=idp
DB_USER=idp
DB_PASSWORD=changeme_local_only

SERVER_PORT=8080

# Must be at least 32 characters. Generated per environment; never reused.
JWT_SECRET=local_development_only_signing_secret_change_me
JWT_EXPIRATION_MS=3600000
